<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <ServerGarbageCollection>true</ServerGarbageCollection>
	<TieredCompilation>true</TieredCompilation>
	<TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <PackageId>DWABench</PackageId>
    <Product>DWABench</Product>
    <Company />
    <Authors>Przemysław Łukawski</Authors>
    <Description>.NET Web API benchmarking tool</Description>
    <AssemblyName>DWABench</AssemblyName>
    <ApplicationIcon>DWABench.ico</ApplicationIcon>
    <Version>1.4</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.8" />
    <PackageReference Include="NReco.Logging.File" Version="1.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetWebApiBench.ApiClient\DotnetWebApiBench.ApiClient.csproj" />
    <ProjectReference Include="..\DotnetWebApiBench.Api\DotnetWebApiBench.Api.csproj" />
  </ItemGroup>

</Project>
